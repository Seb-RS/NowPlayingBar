<?xml version="1.0" encoding="utf-8"?>
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap3="http://schemas.microsoft.com/appx/manifest/uap/windows10/3"
  xmlns:com="http://schemas.microsoft.com/appx/manifest/com/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap uap3 com rescap">

  <Identity Name="Seb.NowPlayingWidget" Publisher="CN=Seb" Version="1.0.0.0" ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>Now Playing Widget</DisplayName>
    <PublisherDisplayName>Seb</PublisherDisplayName>
    <Logo>Assets\Logo150.png</Logo>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.19041.0" MaxVersionTested="10.0.26100.0" />
    <PackageDependency Name="Microsoft.WindowsAppRuntime.1.8" MinVersion="8000.0.0.0"
      Publisher="CN=Microsoft Corporation, O=Microsoft Corporation, L=Redmond, S=Washington, C=US" />
  </Dependencies>

  <Resources>
    <Resource Language="es-es" />
  </Resources>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>

  <Applications>
    <Application Id="App" Executable="NowPlayingWidget.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements DisplayName="Now Playing Widget" Description="Canción actual de Music con controles"
        BackgroundColor="transparent" Square150x150Logo="Assets\Logo150.png" Square44x44Logo="Assets\Logo44.png"
        AppListEntry="none" />
      <Extensions>
        <com:Extension Category="windows.comServer">
          <com:ComServer>
            <com:ExeServer Executable="NowPlayingWidget.exe" Arguments="-RegisterProcessAsComServer" DisplayName="Now Playing Widget">
              <com:Class Id="6C1E5B7A-3F2D-4A8E-9B1C-5D7E2F4A9C31" DisplayName="Now Playing Widget Provider" />
            </com:ExeServer>
          </com:ComServer>
        </com:Extension>
        <uap3:Extension Category="windows.appExtension">
          <uap3:AppExtension Name="com.microsoft.windows.widgets" DisplayName="Now Playing Widget" Id="NowPlayingWidgetApp" PublicFolder="Public">
            <uap3:Properties>
              <WidgetProvider>
                <ProviderIcons>
                  <Icon Path="Assets\Logo150.png" />
                </ProviderIcons>
                <Activation>
                  <CreateInstance ClassId="6C1E5B7A-3F2D-4A8E-9B1C-5D7E2F4A9C31" />
                </Activation>
                <Definitions>
                  <Definition Id="NowPlaying" DisplayName="Music" Description="Canción actual y controles de reproducción"
                    AllowMultiple="false" IsCustomizable="false">
                    <Capabilities>
                      <Capability><Size Name="small" /></Capability>
                      <Capability><Size Name="medium" /></Capability>
                    </Capabilities>
                    <ThemeResources>
                      <Icons>
                        <Icon Path="Assets\Logo150.png" />
                      </Icons>
                      <Screenshots>
                        <Screenshot Path="Assets\Shot.png" DisplayAltText="Widget de Music" />
                      </Screenshots>
                      <DarkMode />
                      <LightMode />
                    </ThemeResources>
                  </Definition>
                </Definitions>
              </WidgetProvider>
            </uap3:Properties>
          </uap3:AppExtension>
        </uap3:Extension>
      </Extensions>
    </Application>
  </Applications>
</Package>
